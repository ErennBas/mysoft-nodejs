# Mysoft Test Ortamı Canlı E2E Senaryo Testi Konfigürasyonu
# NOT: Bu dosya sadece TEST ortamında çalışır. PRODUCTION modunda testler güvenlik nedeniyle otomatik olarak bloke edilir.

MYSOFT_ENVIRONMENT=TEST
MYSOFT_CLIENT_ID=your_test_client_id_here
MYSOFT_CLIENT_SECRET=your_test_client_secret_here

# Test senaryosunda kullanılacak VKN / TCKN bilgileri
MYSOFT_TEST_BUYER_VKN=1234567890
MYSOFT_TEST_BUYER_TCKN=12345678901
MYSOFT_TEST_BUYER_TITLE=Test Alıcı Ticaret Ltd. Şti.
MYSOFT_TEST_BUYER_EMAIL=test@alici.com
