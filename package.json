{
	"name": "mysoft-nodejs",
	"version": "0.0.4-alpha.1",
	"description": "Mysoft GİB E-Dönüşüm (E-Fatura, E-Arşiv, E-İrsaliye, E-SMM, E-Defter vb.) REST API için modern Node.js & TypeScript SDK",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:live": "tsx scripts/run-live-scenario.ts",
		"lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.mjs\"",
		"lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.mjs\" --fix",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.mjs\" \"*.json\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.mjs\" \"*.json\"",
		"typecheck": "tsc --noEmit",
		"new-version": "tsx scripts/bump-version.ts",
		"bump-version": "tsx scripts/bump-version.ts",
		"clean": "rimraf dist coverage"
	},
	"keywords": [
		"mysoft",
		"efatura",
		"e-fatura",
		"earsiv",
		"e-arsiv",
		"eirsaliye",
		"e-irsaliye",
		"esmm",
		"e-smm",
		"edefter",
		"e-defter",
		"gib",
		"gelir-idaresi-baskanligi",
		"ubl-tr",
		"sdk",
		"typescript",
		"nodejs"
	],
	"author": "Eren Baş <erenbas.info@gmail.com> (https://github.com/erennbas)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/erennbas/mysoft-nodejs.git"
	},
	"bugs": {
		"url": "https://github.com/erennbas/mysoft-nodejs/issues"
	},
	"homepage": "https://github.com/erennbas/mysoft-nodejs#readme",
	"dependencies": {
		"axios": "^1.7.9",
		"fflate": "^0.8.2"
	},
	"peerDependencies": {
		"ioredis": "^5.4.2"
	},
	"peerDependenciesMeta": {
		"ioredis": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.13.4",
		"@typescript-eslint/eslint-plugin": "^8.24.1",
		"@typescript-eslint/parser": "^8.24.1",
		"@vitest/coverage-v8": "^3.0.6",
		"dotenv": "^18.0.4",
		"eslint": "^9.20.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"prettier": "^3.5.1",
		"rimraf": "^6.0.1",
		"tsup": "^8.3.6",
		"tsx": "^4.23.15",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.1",
		"vitest": "^3.0.6"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
